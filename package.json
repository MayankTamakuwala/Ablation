{
  "name": "ablation-server",
  "version": "1.0.0",
  "description": "Backend for Ablation, a log for machine learning experiments",
  "type": "module",
  "license": "MIT",
  "author": "Mayank Tamakuwala and Varshith Sai Pothula",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file=.env server/local.js",
    "start": "node server/local.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "seed": "node --env-file=.env scripts/seed.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mongodb": "^7.7.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
